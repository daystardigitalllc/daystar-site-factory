<!-- JAVASCRIPT FILTERING ROUTINES -->
<script>
  const filterButtons = document.querySelectorAll('[data-filter]');
  const categorySections = document.querySelectorAll('[data-category]');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selectedFilter = btn.getAttribute('data-filter') || 'all';

      // 1. Update button styling classes
      filterButtons.forEach((b) => {
        b.classList.remove('bg-primary', 'text-white', 'shadow');
        b.classList.add('text-slate-400', 'hover:text-white', 'hover:bg-slate-800');
      });
      btn.classList.add('bg-primary', 'text-white', 'shadow');
      btn.classList.remove('text-slate-400', 'hover:text-white', 'hover:bg-slate-800');

      // 2. Filter rendering sections
      categorySections.forEach((section) => {
        const category = section.getAttribute('data-category');
        if (selectedFilter === 'all' || category === selectedFilter) {
          section.classList.remove('hidden');
        } else {
          section.classList.add('hidden');
        }
      });
    });
  });
</script>
