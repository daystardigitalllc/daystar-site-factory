---

<MainLayout title="Component Library Catalog" description="Visual preview catalog of all stored UI components.">
  <div class="bg-slate-950 text-white min-h-screen font-sans">
    
    <!-- Top Nav Banner -->
    <header class="border-b border-slate-900 bg-slate-950/80 sticky top-0 z-50 backdrop-blur-md px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-primary to-accent flex items-center justify-center font-extrabold text-xs">DS</div>
        <div>
          <h1 class="text-sm font-bold tracking-tight">Daystar Site Factory</h1>
          <p class="text-[10px] text-slate-500">Component Catalog & Visual Playground</p>
        </div>
      </div>
      <div class="hidden sm:flex items-center gap-3 bg-slate-900 px-3 py-1 rounded-lg border border-slate-800 text-xs text-slate-400">
        <span>Dev Mode Status:</span>
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="font-semibold text-emerald-400">Active</span>
      </div>
    </header>

    <!-- Hero Introduction -->
    <section class="py-16 text-center max-w-3xl mx-auto px-6 space-y-4">
      <span class="text-[10px] font-extrabold uppercase tracking-widest bg-primary/20 text-accent px-3.5 py-1 rounded-full border border-primary/20">Design System Systematics</span>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight">Visual component *showcase*</h2>
      <p class="text-xs sm:text-sm text-slate-400 leading-relaxed max-w-xl mx-auto">
        Click the filters below to browse our library of layout blocks. Each section showcases live previews with direct usage keys so you can copy and reference them in your prompts.
      </p>
    </section>

    <!-- CATEGORY FILTER MENU -->
    <section class="max-w-5xl mx-auto px-6 mb-12">
      <div class="flex flex-wrap gap-2 justify-center bg-slate-900/60 p-1.5 rounded-2xl border border-slate-900 backdrop-blur">
        <button
          data-filter="all"
          class="px-4 py-2 text-xs font-bold rounded-xl bg-primary text-white transition-all shadow cursor-pointer"
        >
          All Blocks
        </button>
        <button
          data-filter="navigation"
          class="px-4 py-2 text-xs font-bold rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-all cursor-pointer"
        >
          Navigation
        </button>
        <button
          data-filter="heroes"
          class="px-4 py-2 text-xs font-bold rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-all cursor-pointer"
        >
          Heroes & Banners
        </button>
        <button
          data-filter="services"
          class="px-4 py-2 text-xs font-bold rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-all cursor-pointer"
        >
          Services & Pricing
        </button>
        <button
          data-filter="showcase"
          class="px-4 py-2 text-xs font-bold rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-all cursor-pointer"
        >
          Showcases & Galleries
        </button>
        <button
          data-filter="social"
          class="px-4 py-2 text-xs font-bold rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-all cursor-pointer"
        >
          Reviews & FAQs
        </button>
        <button
          data-filter="footers"
          class="px-4 py-2 text-xs font-bold rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-all cursor-pointer"
        >
          Footers
        </button>
      </div>
    </section>

    <!-- CONTENT SECTIONS CONTAINER -->
    <main class="space-y-24 pb-32">

      <!-- ================= NAVIGATION SECTION ================= -->
      <section data-category="navigation" class="space-y-16">
        <div class="px-6 max-w-5xl mx-auto border-b border-slate-900 pb-4">
          <h3 class="text-xl font-extrabold text-white tracking-tight flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
            00. Navigation Bars
          </h3>
          <p class="text-xs text-slate-500 mt-1">Frosted headers, floating pills, and editorial split configurations. Note: to prevent overlap in this playground, headers are shown within sandboxed bounds.</p>
        </div>
                <!-- Block item: NavbarPill -->
        <div class="space-y-4">
          <div class="max-w-5xl mx-auto px-6">
            <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="space-y-1">
                <h4 class="text-sm font-bold text-white flex items-center gap-2">
                  NavbarPill.astro
                  <span class="text-[9px] font-semibold bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded border border-emerald-500/10">Active Block</span>
                </h4>
                <p class="text-xs text-slate-400">Floating pill-shaped glass navigation. Best for modern minimal designs.</p>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="text-[10px] text-slate-500 font-mono">Use key:</span>
                <code class="bg-slate-950 px-2.5 py-1 rounded border border-slate-800 text-xs font-mono text-accent select-all">"NavbarPill"</code>
              </div>
            </div>
          </div>
          <div class="border-y border-slate-900 bg-slate-950/20 py-8 relative h-32 flex items-center justify-center overflow-hidden">
            <div class="w-full max-w-xl scale-90 sm:scale-100">
              <NavbarPill />
            </div>
          </div>
        </div>
                <!-- Block item: Header -->
        <div class="space-y-4">
          <div class="max-w-5xl mx-auto px-6">
            <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="space-y-1">
                <h4 class="text-sm font-bold text-white flex items-center gap-2">
                  Header.astro
                  <span class="text-[9px] font-semibold bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded border border-emerald-500/10">Active Block</span>
                </h4>
                <p class="text-xs text-slate-400">Standard full-width sticky header with dropdown support for Services and Locations.</p>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="text-[10px] text-slate-500 font-mono">Use key:</span>
                <code class="bg-slate-950 px-2.5 py-1 rounded border border-slate-800 text-xs font-mono text-accent select-all">"Header"</code>
              </div>
            </div>
          </div>
          <div class="border-y border-slate-900 bg-slate-950/20 py-4 relative h-28 flex items-center justify-center overflow-hidden">
            <div class="w-full max-w-3xl scale-90 sm:scale-100">
              <Header />
            </div>
          </div>
        </div>
                <!-- Block item: NavbarSplitLogo -->
        <div class="space-y-4">
          <div class="max-w-5xl mx-auto px-6">
            <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="space-y-1">
                <h4 class="text-sm font-bold text-white flex items-center gap-2">
                  NavbarSplitLogo.astro
                  <span class="text-[9px] font-semibold bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded border border-emerald-500/10">Active Block</span>
                </h4>
                <p class="text-xs text-slate-400">Editorial navigation with the business logo centered and links split left/right.</p>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="text-[10px] text-slate-500 font-mono">Use key:</span>
                <code class="bg-slate-950 px-2.5 py-1 rounded border border-slate-800 text-xs font-mono text-accent select-all">"NavbarSplitLogo"</code>
              </div>
            </div>
          </div>
          <div class="border-y border-slate-900 bg-slate-950/20 py-4 relative h-28 flex items-center justify-center overflow-hidden">
            <div class="w-full max-w-3xl scale-90 sm:scale-100">
              <NavbarSplitLogo />
            </div>
          </div>
        </div>
                <!-- Block item: Header1 (Fulldev) -->
        <div class="space-y-4">
          <div class="max-w-5xl mx-auto px-6">
            <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="space-y-1">
                <h4 class="text-sm font-bold text-white flex items-center gap-2">
                  Header1 (Fulldev UI)
                  <span class="text-[9px] font-semibold bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded border border-emerald-500/10">Active Block</span>
                </h4>
                <p class="text-xs text-slate-400">Standard clean navigation bar with logo on the left, centered navigation, and action buttons on the right.</p>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="text-[10px] text-slate-500 font-mono">Use key:</span>
                <code class="bg-slate-950 px-2.5 py-1 rounded border border-slate-800 text-xs font-mono text-accent select-all">"Header1"</code>
              </div>
            </div>
          </div>
          <div class="border-y border-slate-900 bg-slate-950/20 py-4 relative h-28 flex items-center justify-center overflow-hidden">
            <div class="w-full max-w-4xl scale-90 sm:scale-100">
              <Header1 logo={mockLogo} navigation={mockHeaderNav} buttons={mockHeaderButtons} />
            </div>
          </div>
        </div>
                <!-- Block item: Header5 (Fulldev) -->
        <div class="space-y-4">
          <div class="max-w-5xl mx-auto px-6">
            <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="space-y-1">
                <h4 class="text-sm font-bold text-white flex items-center gap-2">
                  Header5 (Fulldev UI)
                  <span class="text-[9px] font-semibold bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded border border-emerald-500/10">Active Block</span>
                </h4>
                <p class="text-xs text-slate-400">Two-tier advanced navigation bar supporting sub-link dropdown menus and secondary top actions ribbon.</p>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="text-[10px] text-slate-500 font-mono">Use key:</span>
                <code class="bg-slate-950 px-2.5 py-1 rounded border border-slate-800 text-xs font-mono text-accent select-all">"Header5"</code>
              </div>
            </div>
          </div>
          <div class="border-y border-slate-900 bg-slate-950/20 py-4 relative h-36 flex items-center justify-center overflow-hidden">
            <div class="w-full max-w-4xl scale-90 sm:scale-100">
              <Header5 logo={mockLogo} navigation={mockHeaderNavDetailed} buttons={mockHeaderButtons} />
            </div>
          </div>
        </div>

      </section>

      <!-- ================= HEROES SECTION ================= -->
      <section data-category="heroes" class="space-y-16">
        <div class="px-6 max-w-5xl mx-auto border-b border-slate-900 pb-4">
          <h3 class="text-xl font-extrabold text-white tracking-tight flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
            01. Heroes & Entrance Blocks
          </h3>
          <p class="text-xs text-slate-500 mt-1">Stunning primary banners used at the top of landing pages to capture initial leads.</p>
        </div>
                <!-- Block item: HeroChalet -->
        <div class="space-y-4">
          <div class="max-w-5xl mx-auto px-6">
            <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="space-y-1">
                <h4 class="text-sm font-bold text-white flex items-center gap-2">
                  HeroChalet.astro
                  <span class="text-[9px] font-semibold bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded border border-emerald-500/10">Active Block</span>
                </h4>
                <p class="text-xs text-slate-400">Cozy, rustic alpine style with a customized mountain-ridge bottom SVG clip edge.</p>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="text-[10px] text-slate-500 font-mono">Use key:</span>
                <code class="bg-slate-950 px-2.5 py-1 rounded border border-slate-800 text-xs font-mono text-accent select-all">"HeroChalet"</code>
              </div>
            </div>
          </div>
          <div class="border-y border-slate-900 bg-slate-950/20 py-2">
            <HeroChalet 
              eyebrowOverride="Specialized Alpine Living" 
              headingOverride="A sanctuary in the *mountains*" 
              subtitleOverride="Experience high-end design elements, premium wood structures, and custom architecture."
            />
          </div>
        </div>
                <!-- Block item: Hero1 (Fulldev) -->
        <div class="space-y-4">
          <div class="max-w-5xl mx-auto px-6">
            <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="space-y-1">
                <h4 class="text-sm font-bold text-white flex items-center gap-2">
                  Hero1 (Fulldev UI)
                  <span class="text-[9px] font-semibold bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded border border-emerald-500/10">Active Block</span>
                </h4>
                <p class="text-xs text-slate-400">Centered minimalistic layout with a large typography heading and secondary action anchor.</p>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="text-[10px] text-slate-500 font-mono">Use key:</span>
                <code class="bg-slate-950 px-2.5 py-1 rounded border border-slate-800 text-xs font-mono text-accent select-all">"Hero1"</code>
              </div>
            </div>
          <div class="border-y border-slate-900 bg-slate-950/20 py-2">
            <Hero1 
              title="Modern design systems, simplified."
              description="A library of content-driven Astro components styled dynamically using your custom Tailwind CSS configuration variables."
              buttons={mockButtons}
              image={mockImage}
            />
          </div>
        </div>
                <!-- Block item: Hero5 (Fulldev) -->
        <div class="space-y-4">
          <div class="max-w-5xl mx-auto px-6">
            <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="space-y-1">
                <h4 class="text-sm font-bold text-white flex items-center gap-2">
                  Hero5 (Fulldev UI)
                  <span class="text-[9px] font-semibold bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded border border-emerald-500/10">Active Block</span>
                </h4>
                <p class="text-xs text-slate-400">Two-column split hero showing text content side-by-side with secondary actions list.</p>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="text-[10px] text-slate-500 font-mono">Use key:</span>
                <code class="bg-slate-950 px-2.5 py-1 rounded border border-slate-800 text-xs font-mono text-accent select-all">"Hero5"</code>
              </div>
            </div>
          </div>
          <div class="border-y border-slate-900 bg-slate-950/20 py-2">
            <Hero5 
              title="Built for the modern web."
              description="Deploy high-performance, responsive pages backed by standard components and custom preset styling tokens."
              features={mockFeatures}
              buttons={mockButtons}
              socialProof={mockSocialProof}
              image={mockImage}
            />
          </div>
        </div>



        <!-- Block item: HeroAnimatedEntry -->
        <div class="space-y-4">
          <div class="max-w-5xl mx-auto px-6">
            <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="space-y-1">
                <h4 class="text-sm font-bold text-white flex items-center gap-2">
                  HeroAnimatedEntry.astro
                  <span class="text-[9px] font-semibold bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded border border-emerald-500/10">Active Block</span>
                </h4>
                <p class="text-xs text-slate-400">Centered clean layout with staggered word entrance animation on load.</p>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="text-[10px] text-slate-500 font-mono">Use key:</span>
                <code class="bg-slate-950 px-2.5 py-1 rounded border border-slate-800 text-xs font-mono text-accent select-all">"HeroAnimatedEntry"</code>
              </div>
            </div>
          </div>
          <div class="border-y border-slate-900 bg-slate-950/20 py-8">
            <HeroAnimatedEntry 
              badgeOverride="NEW ENTRANCE ANIMATION"
              headingOverride="Clean words staggered *animation*"
              subtitleOverride="Minimal, fast-loading, and interactive entrance animations built with pure stylesheets."
            />
          </div>
        </div>
                <!-- Block item: HeroCozy -->
        <div class="space-y-4">
          <div class="max-w-5xl mx-auto px-6">
