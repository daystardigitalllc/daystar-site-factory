---
// src/pages/services/index.astro
// Services Hub Page - Lists and connects all S&P Ring Pet Care offerings.
import MainLayout from '../../layouts/MainLayout.astro';
import contentData from '../../data/content.json';
import businessData from '../../data/business.json';
---

<MainLayout 
  title={`Our Pet Care Services | ${businessData.name}`}
  description={`Explore S&P Ring Pet Care's professional services in Clarksville, TN including dog sitting, cat care, dog walking, and timed medication support.`}
>
  <!-- Hero Banner -->
  <section class="relative py-24 bg-slate-900 text-white overflow-hidden text-center select-none">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-1/4 left-1/4 w-[350px] h-[350px] bg-secondary/20 rounded-full blur-[90px] animate-pulse-slow"></div>
    </div>

    <div class="container mx-auto px-6 relative z-10 max-w-3xl space-y-6">
      <span class="text-xs font-bold uppercase tracking-wider text-secondary bg-secondary/10 px-3.5 py-1.5 rounded-full">
        Services Hub
      </span>
      <h1 class="text-4xl sm:text-6xl font-serif font-normal leading-tight tracking-tight text-white">
        Bespoke Pet Care *Offerings*
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-xl mx-auto leading-relaxed">
        Everything is tailored around your dog or cat's exact routines, comfort, and specialized medical needs.
      </p>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-24 bg-[#FAF9F5] text-slate-800 select-none">
    <div class="container mx-auto px-6 max-w-5xl space-y-16">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {contentData.services.map((service, idx) => (
          <div class="bg-white border border-slate-200/60 p-8 shadow-sm relative overflow-hidden rounded-2xl flex flex-col justify-between group transition-all duration-300 hover:border-slate-350 hover:shadow-md">
            <!-- Numeric index badge -->
            <span class="absolute top-4 right-6 text-7xl font-serif font-extrabold text-slate-100/50 select-none pointer-events-none">
              {`0${idx + 1}`}
            </span>

            <div class="space-y-4 relative z-10">
              <h3 class="text-2xl font-bold text-slate-950 tracking-tight">{service.title}</h3>
              <p class="text-slate-500 text-sm leading-relaxed max-w-md">{service.shortDescription}</p>
              
              <!-- Core features bullets checklist -->
              <ul class="space-y-2 pt-2 text-xs font-semibold text-slate-650">
                {service.features.slice(0, 3).map((feat) => (
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-secondary shrink-0"></span>
                    {feat}
                  </li>
                ))}
              </ul>
            </div>

            <!-- Action button -->
            <div class="mt-8 pt-4 border-t border-slate-100 flex items-center justify-between relative z-10">
              <a 
                href={`/services/${service.slug}`} 
                class="text-xs font-extrabold uppercase tracking-widest text-[#002060] hover:text-[#7ba4db] transition-colors flex items-center gap-1.5"
              >
                Explore Service <i class="fa-solid fa-arrow-right text-[10px]"></i>
              </a>
            </div>

          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-20 bg-white text-center border-t border-b border-slate-200/60 select-none">
    <div class="container mx-auto px-6 max-w-2xl space-y-6">
      <h3 class="text-2xl sm:text-3xl font-serif font-normal text-slate-950">Need a specialized package?</h3>
      <p class="text-xs sm:text-sm text-slate-500 max-w-md mx-auto leading-relaxed">
        Let's discuss your pet's medication schedules or boarding checklist in a friendly meet-and-greet.
      </p>
      <div class="pt-2">
        <a 
          href={`tel:${businessData.phone}`} 
          class="inline-flex items-center justify-center px-6 py-3.5 bg-primary hover:bg-primary-hover text-white text-xs sm:text-sm font-bold tracking-wider rounded-xl transition-all shadow-md"
        >
          Call or Text: {businessData.phone}
        </a>
      </div>
    </div>
  </section>
</MainLayout>
