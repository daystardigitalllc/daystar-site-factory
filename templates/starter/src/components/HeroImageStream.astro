---
// HeroImageStream.astro
// Two rails of portfolio-photo cards ride from far behind the screen toward
// the viewer, past a centered headline. Concept ported from a React
// "image-stream-hero" component, rebuilt from scratch as a pure Astro
// component — the entire corridor curve is computed once at build time in
// this frontmatter (plain geometry math, no client JS needed to trace it),
// and the result is baked into static `@keyframes` + per-card
// `animation-delay` values. The only client-side behavior is respecting
// `prefers-reduced-motion` (handled in pure CSS, no JS at all).
//
// Best for brands whose best sales pitch is the work itself — portfolio-
// heavy trades and creative studios (web/design agencies, photographers,
// remodelers, boutique retail) where you want the hero to lead with real
// project photos in motion instead of a static image or video loop.
//
// How the corridor is shaped (why the numbers below are what they are):
// 1. Depth is authored as *apparent size*, geometrically — each card is a
//    constant ratio bigger than the one behind it, all the way out. A
//    straight z-range instead makes the near cards tear apart as the
//    perspective projection blows up.
// 2. The rails open hard in the first stretch and then hold (`fan` > 1),
//    which cancels the still-slow growth back there — the ribbon leaves
//    center as a flat band, bends once, then runs out on the diagonal.
// 3. Neither end of the loop is ever on screen: a card dies with its inner
//    edge past 50cqw, and is born *across* the axis (`railBirth` negative)
//    so a newborn always lands behind cards that already cover the center —
//    no fade-in needed, and no hole blinking open at the vanishing point.
//
// Every length is `cqw` (a percentage of the container's width), so the
// whole corridor keeps its proportions at any size. Requires the client's
// own project photos — there's no stock/placeholder image source.
import businessData from '../data/business.json';
import contentData from '../data/content.json';

export interface StreamImage {
  src: string;
  alt?: string;
}

export interface CorridorPath {
  /** Strength of the projection. Lower is a wider-angle, more dramatic rush. @default 30 */
  perspective?: number;
  /** Card width in world units. @default 18 */
  cardWidth?: number;
  /** Card height in world units. @default 25 */
  cardHeight?: number;
  /** Corner radius applied to each card. @default 0.4 */
  cardRadius?: number;
  /** On-screen card height at the waist, where a card is born. @default 2.6 */
  birthHeight?: number;
  /** On-screen card height as a card leaves the frame. @default 46 */
  exitHeight?: number;
  /** Lateral offset at birth. Negative starts the card across the axis so the centre never opens up. @default -11 */
  railBirth?: number;
  /** Lateral offset once the rails have finished opening. @default 44 */
  railExit?: number;
  /** How front-loaded the opening is. >1 opens early then holds. @default 3.3 */
  fan?: number;
  /** Y-rotation at birth, degrees. @default 6 */
  turnBirth?: number;
  /** Y-rotation at exit, degrees. @default 28 */
  turnExit?: number;
  /** Keyframe stops used to trace the curve. Raise only if motion looks faceted. @default 24 */
  stops?: number;
}

interface Props {
  /** Images cycled onto the rails. Both rails run the same sequence (offset), so the corridor reads as one stream. Fewer than `cards` simply repeat. */
  imagesOverride?: StreamImage[];
  /** Cards on each rail at once. More cards = denser, not faster — spacing derives from this and `speed`. @default 9 */
  cards?: number;
  /** Seconds for one card to travel the whole corridor. @default 18 */
  speed?: number;
  /** Vertical placement of the corridor's axis, as a percentage of height. @default 55 */
  axis?: number;
  /** Override any part of the corridor geometry. Merged over the defaults. */
  path?: CorridorPath;
  badgeOverride?: string;
  headingOverride?: string;
  subtitleOverride?: string;
  primaryCtaTextOverride?: string;
  primaryCtaHrefOverride?: string;
  secondaryCtaTextOverride?: string;
  secondaryCtaHrefOverride?: string;
}

const {
  imagesOverride,
  cards = 9,
  speed = 18,
  axis = 55,
  path,
  badgeOverride,
  headingOverride,
  subtitleOverride,
  primaryCtaTextOverride,
  primaryCtaHrefOverride,
  secondaryCtaTextOverride,
  secondaryCtaHrefOverride,
} = Astro.props;

const data = contentData.home?.imageStreamHero;

const images: StreamImage[] = imagesOverride || data?.images || [];
const badge = badgeOverride || data?.badge || '';
const heading = headingOverride || data?.heading || businessData.name;
const subtitle = subtitleOverride || data?.subtitle || '';
const primaryCtaText = primaryCtaTextOverride || data?.primaryCtaText || businessData.mainCta || 'Get a Free Quote';
const primaryCtaHref = primaryCtaHrefOverride || data?.primaryCtaHref || '#quote-funnel';
const secondaryCtaText = secondaryCtaTextOverride || data?.secondaryCtaText || 'Call Us';
const secondaryCtaHrefRaw = secondaryCtaHrefOverride || data?.secondaryCtaHref || 'tel:';
const secondaryCtaHref = secondaryCtaHrefRaw === 'tel:' ? `tel:${businessData.phone}` : secondaryCtaHrefRaw;

const PATH: Required<CorridorPath> = {
  perspective: 30,
  cardWidth: 18,
  cardHeight: 25,
  cardRadius: 0.4,
  birthHeight: 2.6,
  exitHeight: 46,
  railBirth: -11,
  railExit: 44,
  fan: 3.3,
  turnBirth: 6,
  turnExit: 28,
  stops: 24,
  ...path,
};

// Trace the corridor curve once at build time. `dir` mirrors the geometry
// for the left rail (-1) vs the right rail (1).
function keyframes(dir: 1 | -1, name: string, p: Required<CorridorPath>): string {
  const steps: string[] = [];
  for (let s = 0; s <= p.stops; s++) {
    const u = s / p.stops;
    // Geometric in apparent size, so consecutive cards keep a constant size
    // ratio and the ribbon stays solid at both ends.
    const scale = (p.birthHeight / p.cardHeight) * Math.pow(p.exitHeight / p.birthHeight, u);
    const z = p.perspective * (1 - 1 / scale);
    const rail = p.railExit - (p.railExit - p.railBirth) * Math.pow(1 - u, p.fan);
    const turn = p.turnBirth + (p.turnExit - p.turnBirth) * u;
    steps.push(
      `${(u * 100).toFixed(2)}%{transform:translate3d(${(dir * rail).toFixed(2)}cqw,0,${z.toFixed(2)}cqw) rotateY(${(-dir * turn).toFixed(2)}deg)}`
    );
  }
  return `@keyframes ${name}{${steps.join('')}}`;
}

const uid = Math.random().toString(36).slice(2, 8);
const rightName = `ish-r-${uid}`;
const leftName = `ish-l-${uid}`;
const cardClass = `ish-c-${uid}`;

const keyframesCss = keyframes(1, rightName, PATH) + keyframes(-1, leftName, PATH);

// Both rails walk the same image sequence, offset from each other so they
// don't show the same photo at the same depth at the same time.
function buildRail(name: string, offset: number) {
  return Array.from({ length: cards }, (_, i) => {
    const img = images.length ? images[(i + offset) % images.length] : null;
    // Negative delay drops each card mid-flight, so the corridor is already
    // full on the first frame — no build-up, no empty rails on load.
    const delay = -((i * speed) / cards);
    return { img, animationName: name, delay };
  });
}
const rightRail = buildRail(rightName, 0);
const leftRail = buildRail(leftName, Math.ceil(images.length / 2));
---

<section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden bg-slate-950 text-center">
  <style set:html={`
    .ish-container-${uid} { container-type: inline-size; }
    .ish-persp-${uid} { perspective: ${PATH.perspective}cqw; perspective-origin: 50% ${axis}%; }
    .${cardClass} {
      position: absolute;
      left: 50%;
      top: ${axis}%;
      width: ${PATH.cardWidth}cqw;
      height: ${PATH.cardHeight}cqw;
      margin-left: ${-PATH.cardWidth / 2}cqw;
      margin-top: ${-PATH.cardHeight / 2}cqw;
      border-radius: ${PATH.cardRadius}cqw;
      overflow: hidden;
      backface-visibility: hidden;
      animation-duration: ${speed}s;
      animation-timing-function: linear;
      animation-iteration-count: infinite;
    }
    .${cardClass} img { width: 100%; height: 100%; object-fit: cover; display: block; }
    @media (prefers-reduced-motion: reduce) {
      /* Pausing (not disabling) keeps the corridor whole: every card is
         already dropped mid-flight by its negative delay, so it freezes as
         a finished still instead of collapsing onto the axis. */
      .${cardClass} { animation-play-state: paused; }
    }
    ${keyframesCss}
  `} />

  <div class={`ish-container-${uid} pointer-events-none absolute inset-0`} aria-hidden="true">
    <div class={`ish-persp-${uid} absolute inset-0`}>
      <div class="absolute inset-0" style="transform-style: preserve-3d;">
        {rightRail.map((c) => (
          <div class={cardClass} style={`animation-name:${c.animationName};animation-delay:${c.delay.toFixed(3)}s;`}>
            {c.img && <img src={c.img.src} alt={c.img.alt ?? ''} loading="lazy" decoding="async" draggable="false" />}
          </div>
        ))}
        {leftRail.map((c) => (
          <div class={cardClass} style={`animation-name:${c.animationName};animation-delay:${c.delay.toFixed(3)}s;`}>
            {c.img && <img src={c.img.src} alt={c.img.alt ?? ''} loading="lazy" decoding="async" draggable="false" />}
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="absolute inset-0 bg-gradient-to-b from-slate-950/55 via-slate-950/60 to-slate-950 pointer-events-none"></div>

  <div class="relative z-10 max-w-2xl mx-auto px-6">
    {badge && (
      <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-primary bg-primary/10 border border-primary/30 px-4 py-2 rounded-full mb-6">
        {badge}
      </span>
    )}
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight leading-[1.1] text-white">
      {heading}
    </h1>
    {subtitle && <p class="mt-5 text-base sm:text-lg text-slate-300 max-w-lg mx-auto">{subtitle}</p>}
    <div class="mt-9 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={primaryCtaHref}
        class="inline-flex items-center justify-center px-7 py-3.5 rounded-custom text-sm font-bold text-white bg-primary hover:bg-primary-hover transition-all hover:scale-105 shadow-md shadow-primary/20"
      >
        {primaryCtaText}
      </a>
      <a
        href={secondaryCtaHref}
        class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-custom text-sm font-bold text-white border-2 border-white/20 hover:border-primary hover:text-primary transition-all"
      >
        {secondaryCtaText}
      </a>
    </div>
  </div>
</section>
